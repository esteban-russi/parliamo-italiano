# GCP Vertex AI & Cloud Services Configuration
# GCP_PROJECT: Your Google Cloud Project ID (e.g. "my-project-123456")
GCP_PROJECT="YOUR_GCP_PROJECT_ID"

# GCP_REGION: Vertex AI region (e.g. "europe-west2", "us-central1", or "global")
GCP_REGION="global"

# Gemini Models Configuration
# GEMINI_CHAT_MODEL: Primary model for conversation and pedagogical grammar notes.
# Recommended: "gemini-2.5-flash" (or "gemini-2.0-flash")
GEMINI_CHAT_MODEL="gemini-3.5-flash"

# GEMINI_TTS_MODEL: Model for Gemini multimodal audio/speech generation.
# Use a speech-generation (TTS) model; general chat models may not return audio.
# Recommended: "gemini-3.8-flash-lite-tts"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# GEMINI_MODEL: Generic model fallback if specific chat/tts models are not set.
GEMINI_MODEL="gemini-2.5-flash"

# Google AI Studio API Key (Fallback if Vertex AI / ADC credentials are not configured)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server configuration
PORT=3000

# Max billed API requests (/api/chat, /api/tts, /api/stt) per IP per minute
RATE_LIMIT_PER_MINUTE=60

# Number of reverse proxies in front of the app (set to 1 on Cloud Run) so
# rate limiting sees the real client IP
TRUST_PROXY_HOPS=0
NODE_ENV="development"
APP_URL="http://localhost:3000"
